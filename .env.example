# Local defaults are shown below. For Render, set DATABASE_URL to your Neon
# connection string and REDIS_URL to your Upstash Redis URL in the dashboard.
# Get Neon at https://neon.tech and Upstash at https://upstash.com.
# Render does not auto-provision these external services.
# DATABASE_URL and REDIS_URL are the variable names read by the application.
NEON_DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dbname?sslmode=require
UPSTASH_REDIS_URL=rediss://default:password@us1-example.upstash.io:6379

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_knowledge_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_knowledge_agent
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=600
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
API_PORT=8000
CLIENT_PORT=80
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost
JWT_SECRET_KEY=change-me-to-a-long-random-string
